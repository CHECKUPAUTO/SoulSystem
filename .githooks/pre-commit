#!/bin/bash
# pre-commit hook — exécute auto-verify sur les fichiers staged

set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
VERIFY_SCRIPT="$ROOT_DIR/skills/auto-verify/verify.sh"

EXIT_CODE=0

# Get list of staged files
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED" ]; then
  echo "ℹ️ Aucun fichier staged, skip pre-commit"
  exit 0
fi

echo "🔍 [pre-commit] Vérification des fichiers staged..."

while IFS= read -r file; do
  filepath="$ROOT_DIR/$file"
  if [ -f "$filepath" ]; then
    case "$filepath" in
      *.py|*.js|*.ts|*.tsx|*.sh|*.json|*.md)
        if ! bash "$VERIFY_SCRIPT" "$filepath"; then
          EXIT_CODE=1
        fi
        ;;
      *)
        echo "ℹ️ Skip: $file"
        ;;
    esac
  fi
done <<< "$STAGED"

if [ "$EXIT_CODE" -eq 0 ]; then
  echo "✅ [pre-commit] Tous les checks passent"
else
  echo "❌ [pre-commit] Échec — corrigez les erreurs avant de commit"
fi

exit $EXIT_CODE
