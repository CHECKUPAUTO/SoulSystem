{
  "dashboard": {
    "id": null,
    "title": "SoulSystem Telemetry",
    "tags": ["soulsystem", "telemetry", "monitoring"],
    "style": "dark",
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "System Overview",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "collapsed": false
      },
      {
        "id": 2,
        "title": "CPU Temperature",
        "type": "gauge",
        "datasource": "Prometheus",
        "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
        "targets": [
          {
            "expr": "soul_current_temp_celsius",
            "legendFormat": "Temperature"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "celsius",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" },
                { "value": 60, "color": "yellow" },
                { "value": 80, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Active Workers",
        "type": "stat",
        "datasource": "Prometheus",
        "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
        "targets": [
          {
            "expr": "soul_active_workers",
            "legendFormat": "Workers"
          }
        ]
      },
      {
        "id": 4,
        "title": "Queue Depth",
        "type": "stat",
        "datasource": "Prometheus",
        "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
        "targets": [
          {
            "expr": "soul_queue_depth",
            "legendFormat": "Queue"
          }
        ]
      },
      {
        "id": 5,
        "title": "Registered Agents",
        "type": "stat",
        "datasource": "Prometheus",
        "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
        "targets": [
          {
            "expr": "soul_orchestrator_agents_registered",
            "legendFormat": "Agents"
          }
        ]
      },
      {
        "id": 10,
        "title": "Scheduler Metrics",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
        "collapsed": false
      },
      {
        "id": 11,
        "title": "Tasks Submitted (Rate)",
        "type": "timeseries",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "rate(soul_scheduler_tasks_submitted_total[5m])",
            "legendFormat": "Submitted/sec"
          }
        ]
      },
      {
        "id": 12,
        "title": "Tasks Completed (Rate)",
        "type": "timeseries",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
        "targets": [
          {
            "expr": "rate(soul_scheduler_tasks_completed_total[5m])",
            "legendFormat": "Completed/sec"
          }
        ]
      },
      {
        "id": 13,
        "title": "Work-Stealing Success Rate",
        "type": "timeseries",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
        "targets": [
          {
            "expr": "rate(soul_scheduler_steal_successes_total[5m]) / rate(soul_scheduler_steal_attempts_total[5m])",
            "legendFormat": "Steal Success Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1
          }
        }
      },
      {
        "id": 14,
        "title": "Task Execution Time (P95)",
        "type": "timeseries",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(soul_scheduler_task_execution_seconds_bucket[5m]))",
            "legendFormat": "P95 Latency"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 15,
        "title": "Task Execution Time (P50)",
        "type": "timeseries",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(soul_scheduler_task_execution_seconds_bucket[5m]))",
            "legendFormat": "P50 Latency"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 16,
        "title": "Thermal Throttle Events (Rate)",
        "type": "timeseries",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
        "targets": [
          {
            "expr": "rate(soul_scheduler_thermal_throttle_total[5m])",
            "legendFormat": "Throttles/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "fixed", "fixedColor": "orange" }
          }
        }
      },
      {
        "id": 20,
        "title": "Task Execution",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
        "collapsed": false
      },
      {
        "id": 21,
        "title": "Tasks Executed (Rate)",
        "type": "timeseries",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
        "targets": [
          {
            "expr": "rate(soul_tasks_executed_total[5m])",
            "legendFormat": "Executed/sec"
          }
        ]
      },
      {
        "id": 22,
        "title": "Tasks Stolen (Rate)",
        "type": "timeseries",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
        "targets": [
          {
            "expr": "rate(soul_tasks_stolen_total[5m])",
            "legendFormat": "Stolen/sec"
          }
        ]
      },
      {
        "id": 30,
        "title": "Orchestrator",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
        "collapsed": false
      },
      {
        "id": 31,
        "title": "Message Dispatches (Rate)",
        "type": "timeseries",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 34 },
        "targets": [
          {
            "expr": "rate(soul_orchestrator_dispatch_total[5m])",
            "legendFormat": "Dispatches/sec"
          }
        ]
      },
      {
        "id": 32,
        "title": "Messages Delivered (Rate)",
        "type": "timeseries",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 34 },
        "targets": [
          {
            "expr": "rate(soul_orchestrator_dispatch_delivered_total[5m])",
            "legendFormat": "Delivered/sec"
          }
        ]
      },
      {
        "id": 33,
        "title": "Mailbox Full Events (Rate)",
        "type": "timeseries",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 34 },
        "targets": [
          {
            "expr": "rate(soul_orchestrator_mailbox_full_total[5m])",
            "legendFormat": "Full/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "fixed", "fixedColor": "red" }
          }
        }
      },
      {
        "id": 40,
        "title": "Worker Activity",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
        "collapsed": false
      },
      {
        "id": 41,
        "title": "Worker Idle Cycles (Rate)",
        "type": "timeseries",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
        "targets": [
          {
            "expr": "rate(soul_scheduler_worker_idle_cycles_total[5m])",
            "legendFormat": "Idle Cycles/sec"
          }
        ]
      },
      {
        "id": 42,
        "title": "Total Queue Depth",
        "type": "timeseries",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
        "targets": [
          {
            "expr": "soul_scheduler_queue_depth_total",
            "legendFormat": "Total Depth"
          }
        ]
      }
    ],
    "schemaVersion": 38,
    "version": 1
  }
}