[workspace]
members = [
    "scirust-macros",
    "scirust-autodiff",
    "scirust-simd-macros",
    "scirust-simd",
    "scirust-gpu",
    "scirust-gpu-macros",
    "scirust-core",
    "scirust-symbolic",
    "scirust-reasoning",
    "scirust-learning",
    "scirust-inference",
    "scirust-bridge",
    "scirust-genetic",
    "scirust-probability",
    "scirust-cli",
    "examples/demo",
    "examples/benchmarks",
]
exclude = ["scirust-rustc-driver"]
resolver = "2"
