# ═══════════════════════════════════════════════
# SoulSystem Evolution v0.3 — Configuration
# ═══════════════════════════════════════════════

# ── Ollama (3 modèles) ───────────────────────
SOULSYSTEM_EVO_OLLAMA_URL=http://localhost:11434
SOULSYSTEM_EVO_MODEL_FAST=qwen3.5:4b
SOULSYSTEM_EVO_MODEL_DEEP=llama3:8b
SOULSYSTEM_EVO_MODEL_EMBED=nomic-embed-text

# ── GPU RTX 4060 ─────────────────────────────
SOULSYSTEM_EVO_MAX_CONCURRENT_FAST=2
SOULSYSTEM_EVO_MAX_CONCURRENT_DEEP=1
SOULSYSTEM_EVO_CONTEXT_WINDOW_FAST=2048
SOULSYSTEM_EVO_CONTEXT_WINDOW_DEEP=4096

# ── Population ───────────────────────────────
SOULSYSTEM_EVO_POPULATION_SIZE=20
SOULSYSTEM_EVO_MUTATION_RATE=0.3
SOULSYSTEM_EVO_SURVIVAL_RATE=0.5

# ── Stagnation (bascule FAST → DEEP) ────────
SOULSYSTEM_EVO_STAGNATION_THRESHOLD=10
SOULSYSTEM_EVO_STAGNATION_MIN_IMPROVEMENT=0.005

# ── Sandbox (exécution réelle du code) ───────
SOULSYSTEM_EVO_SANDBOX_ENABLED=true
SOULSYSTEM_EVO_SANDBOX_TIMEOUT=30

# ── Système ──────────────────────────────────
SOULSYSTEM_EVO_SNAPSHOT_INTERVAL=5
SOULSYSTEM_EVO_CYCLE_DELAY=5
SOULSYSTEM_EVO_MAX_CRAWL_RESULTS=20
SOULSYSTEM_EVO_HTTP_TIMEOUT=30
SOULSYSTEM_EVO_CRAWLER_RETRIES=3

# ── Logging ──────────────────────────────────
RUST_LOG=info
