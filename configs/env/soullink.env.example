# SoulLink environment configuration — TEMPLATE
#
# Copy this file to `soullink.env` and fill in your own values.
# The real `soullink.env` is git-ignored and MUST NOT be committed:
# it holds secrets (bot tokens) and personal data (chat IDs, phone numbers).

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=kimi-k2.5:cloud
SOULLINK_DIR=/opt/soullink
SOULLINK_DB=/opt/soullink/data/soullink.db
SKILLS_DIR=/opt/soullink/skills
BACKUP_DIR=/opt/soullink/data/backups
LOG_FILE=/opt/soullink/data/soullink.log

# Telegram — get a token from @BotFather, then set your own allowed user IDs.
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_IDS=your_telegram_user_id_here

# WhatsApp
WHATSAPP_ALLOWED_NUMBERS=your_whatsapp_number_here
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3000
WHATSAPP_WEBHOOK_PORT=3002
WA_BRIDGE_PORT=3000
WA_SESSION_DIR=/opt/soullink/data/wa_session
WA_PYTHON_WEBHOOK=http://127.0.0.1:3002/webhook

OPENCLAW_DIR=/opt/openclaw
OPENCLAW_SESSION=/opt/openclaw/.session
OPENCLAW_PID=/opt/openclaw/openclaw.pid

AGENT_MAX_TURNS=12
AGENT_MAX_HISTORY=20
REFLECT_EVERY=10
RATE_MAX=20
SKILL_MIN_CALLS=5
SKILL_DROP_BELOW=0.30

# Upgrade — repo git local (le plus simple)
UPGRADE_GIT_REPO=/opt/soullink-src
UPGRADE_INTERVAL=3600
UPGRADE_AUTO_APPLY=true
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
