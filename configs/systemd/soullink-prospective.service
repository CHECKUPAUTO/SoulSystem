[Unit]
Description=SoulLink V12 Lobe Prospective — Oeil sur le Monde
After=network.target soullink-logic.service soullink-archive.service

[Service]
Type=simple
User=root
WorkingDirectory=/mnt/nvme/soullink_brain
ExecStart=/bin/sh -c 'if [ -f "/mnt/nvme/soullink_brain/brain_v12_prospective.py" ]; then exec ; else echo "[2026-05-04T10:58:50+02:00] /mnt/nvme/soullink_brain/brain_v12_prospective.py not found — service skipped" >&2; exit 0; fi'
Restart=always
RestartSec=3
Environment="PYTHONPATH=/mnt/nvme/soullink_brain"

[Install]
WantedBy=soullink.target
