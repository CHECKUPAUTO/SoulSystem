[Unit]
Description=SoulLink Memory Organ — Persistent episodic + semantic memory
After=network.target soullink-orchestrator.service
Wants=soullink-orchestrator.service

[Service]
Type=simple
ExecStart=/usr/local/bin/soullink-memory $PORT /mnt/nvme/soullink_brain/memory_store
Restart=always
RestartSec=5
Environment=RUST_LOG=info

[Install]
WantedBy=soullink.target