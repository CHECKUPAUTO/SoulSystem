[Unit]
Description=SoulLink Science Organ — HNN v7.0+math
After=network.target soullink-orchestrator.service soullink-memory.service
Wants=soullink-orchestrator.service soullink-memory.service

[Service]
Type=simple
ExecStart=/opt/soullink-node/soullink-node science 9010
WorkingDirectory=/mnt/nvme/soullink_brain
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=soullink.target
