[workspace]

[package]
name = "chronos-agent"
version = "0.5.0"
edition = "2021"
publish = false

[[bin]]
name = "chronos-agent"
path = "src/main.rs"

[[bin]]
name = "stress-test"
path = "src/bin/stress_test.rs"

[dependencies]
candle-core = "0.10"
candle-nn = "0.10"
rand = "0.8"
rand_distr = "0.4"
rayon = "1.10"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
csv = "1.3"

[profile.release]
opt-level = 3
lto = "fat"
codegen-units = 1
