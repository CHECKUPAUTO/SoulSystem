[workspace]
members = ["crates/*"]
resolver = "2"

[workspace.package]
version      = "0.1.0"
edition      = "2021"
rust-version = "1.88"
license      = "MIT OR Apache-2.0"
authors      = ["CHECKUPAUTO"]
repository   = "https://github.com/CHECKUPAUTO/AVID"
documentation = "https://github.com/CHECKUPAUTO/AVID"
description  = "Autonomous Verification & Intelligent Development — LLM-driven engineering intelligence with plagiarism detection and sandboxed code execution"

[profile.release]
lto              = "fat"
codegen-units    = 1
panic            = "abort"
strip            = "symbols"
opt-level        = 3
debug            = false
overflow-checks  = false
incremental      = false
