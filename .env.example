# ═══════════════════════════════════════════════
# OpenClaw Evolution v0.3 — Configuration
# ═══════════════════════════════════════════════

# ── Ollama (3 modèles) ───────────────────────
OPENCLAW_OLLAMA_URL=http://localhost:11434
OPENCLAW_MODEL_FAST=qwen3.5:4b
OPENCLAW_MODEL_DEEP=llama3:8b
OPENCLAW_MODEL_EMBED=nomic-embed-text

# ── GPU RTX 4060 ─────────────────────────────
OPENCLAW_MAX_CONCURRENT_FAST=2
OPENCLAW_MAX_CONCURRENT_DEEP=1
OPENCLAW_CONTEXT_WINDOW_FAST=2048
OPENCLAW_CONTEXT_WINDOW_DEEP=4096

# ── Population ───────────────────────────────
OPENCLAW_POPULATION_SIZE=20
OPENCLAW_MUTATION_RATE=0.3
OPENCLAW_SURVIVAL_RATE=0.5

# ── Stagnation (bascule FAST → DEEP) ────────
OPENCLAW_STAGNATION_THRESHOLD=10
OPENCLAW_STAGNATION_MIN_IMPROVEMENT=0.005

# ── Sandbox (exécution réelle du code) ───────
OPENCLAW_SANDBOX_ENABLED=true
OPENCLAW_SANDBOX_TIMEOUT=30

# ── Système ──────────────────────────────────
OPENCLAW_SNAPSHOT_INTERVAL=5
OPENCLAW_CYCLE_DELAY=5
OPENCLAW_MAX_CRAWL_RESULTS=20
OPENCLAW_HTTP_TIMEOUT=30
OPENCLAW_CRAWLER_RETRIES=3

# ── Logging ──────────────────────────────────
RUST_LOG=info
